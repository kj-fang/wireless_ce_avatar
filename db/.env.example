# Server-side only. Copy this file to db/.env on the ingestion worker.
# db/.env is ignored by Git. This file is a template: it must never contain a
# real host, account, or password — those go in db/.env only.

TELEMETRY_DB_HOST=your-postgres-host.example.com
TELEMETRY_DB_PORT=5432
TELEMETRY_DB_NAME=your_database
TELEMETRY_DB_USER=your_app_role
TELEMETRY_DB_PASSWORD=

# Optional: use one SQLAlchemy URL instead of the fields above.
# TELEMETRY_DSN=postgresql+psycopg://user:password@host:5432/database

# Optional override for the Gather SMB source.
# TELEMETRY_GATHER_SOURCE=\your-file-server\share\path\Gather
